{
  "entities": {
    "Trade": {
      "title": "Trade",
      "description": "A financial trade entry in the trading journal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "symbol": { "type": "string" },
        "direction": { "type": "string", "enum": ["LONG", "SHORT"] },
        "entryDate": { "type": "string" },
        "entryPrice": { "type": "number" },
        "exitPrice": { "type": "number" },
        "pnl": { "type": "number" },
        "pnlR": { "type": "number" },
        "status": { "type": "string", "enum": ["WIN", "LOSS", "OPEN", "BE"] },
        "emotion": { "type": "string" },
        "emotionCategory": { "type": "string", "enum": ["POSITIVE", "NEGATIVE", "NEUTRAL"] },
        "notes": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["symbol", "direction", "entryDate", "pnl", "status", "emotion"]
    }
  },
  "firestore": {
    "/trades/{tradeId}": {
      "schema": "Trade",
      "description": "Collection of journal trades synced with the database engine"
    },
    "/signals/{signalId}": {
      "schema": "Trade",
      "description": "Collection of signals generated by the quantitative engine"
    }
  }
}
